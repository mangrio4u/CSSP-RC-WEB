# ==============================================================================
# RC SINDHRI - ENVIRONMENT CONFIGURATION (.env)
# ==============================================================================

# 1. ImgBB API Integration (Required for production image hosting)
# Get your free API key at: https://api.imgbb.com/
IMGBB_API_KEY=your_imgbb_api_key_here

# 2. Supabase PostgreSQL Database (Required for production database)
# Get these from your Supabase project settings -> API:
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_secret_key_here
SUPABASE_ANON_KEY=your_supabase_anon_public_key_here

# 3. Admin Security & Authentication
# Custom JWT signing secret (use a strong random string)
ADMIN_JWT_SECRET=super_secret_jwt_key_rc_sindhri_production_2026

# Default Administrator Login Email
ADMIN_EMAIL=rcsindhri@gmail.com

# Administrator Password Hash (bcrypt) or initial password
# Generate bcrypt hash or use default initial password: Admin#Sindhri2026!
# ADMIN_PASSWORD_HASH=$2a$10$YourBcryptHashHere
